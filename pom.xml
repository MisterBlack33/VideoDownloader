<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.example</groupId>
    <artifactId>videodownloader</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>HLS Video Downloader</name>
    <description>
        Modulares, erweiterbares Konsolenprogramm zum Erkennen und Herunterladen
        von Videos (u.a. JW Player 8.x + HLS) von Webseiten, unter Verwendung von FFmpeg.
        Es werden ausschliesslich oeffentlich zugaengliche Streams verarbeitet;
        DRM-, Login- oder sonstige Zugriffsschutzmassnahmen werden NICHT umgangen.
    </description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <!--
        Bewusst ohne externe Abhaengigkeiten:
        - HTTP: java.net.http.HttpClient (JDK)
        - HTML-Analyse: einfache, gezielte Regex-/String-Suche (kein DOM-Parsing noetig,
          da nur nach script-Inhalten und <video>-Tags gesucht wird).
        Falls gewuenscht, kann hier zusaetzlich jsoup als Abhaengigkeit ergaenzt werden.
    -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>VideoDownloader</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>videodownloader.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
